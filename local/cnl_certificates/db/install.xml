<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="local/cnl_certificates/db" VERSION="2026061600" COMMENT="Database tables for CNL certificates plugin">
    <TABLES>
        <TABLE NAME="local_cnl_certificates" COMMENT="Certificates generated for users">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="code" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="Unique certificate code"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User ID"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
                <FIELD NAME="hours" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="40" COMMENT="Course hours"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Timestamp"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="code_unique" TYPE="unique" FIELDS="code"/>
                <KEY NAME="user_course_unique" TYPE="unique" FIELDS="userid,courseid"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/> 
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_cnl_cert_hours" COMMENT="Custom hours per course (optional)">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
                <FIELD NAME="hours" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="40" COMMENT="Hours"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="courseid_unique" TYPE="unique" FIELDS="courseid"/>
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
